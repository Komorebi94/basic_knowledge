    "verify:pages": "node scripts/verify-pages.mjs",
    "verify:pages:browser": "node scripts/verify-pages-browser.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:runner": "vite preview --config runner/vite.config.js",
    "verify:runner": "node scripts/verify-runner.mjs",
    "verify:store": "node scripts/verify-personal-store.mjs",
    "verify:search": "node scripts/verify-search.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:personal": "node scripts/verify-personal-ui.mjs",
    "verify:visual": "node scripts/capture-reading.mjs",
