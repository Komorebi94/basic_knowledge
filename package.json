    "verify:pages": "node scripts/verify-pages.mjs",
    "verify:pages:browser": "node scripts/verify-pages-browser.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "preview": "vite preview",
